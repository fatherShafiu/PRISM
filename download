    parser.add_argument("--quick", action="store_true",
                        help="Skip the robustness sweep (faster run)")
    parser.add_argument("--seed", type=int, default=42)
    args = parser.parse_args()

    seed = args.seed
    np.random.seed(seed)

    print("=" * 60)
    print("  PRISM Experiment Suite")
    print("=" * 60)

    # 1. Data
    df, _ = load_or_generate(seed)

    # 2. Baselines
    results, lr, lr_probs, rf_probs, xgb_probs, rule_score, y, X, Xs = \
        run_baselines(df, seed)

    # 3. Ablation
    ablation = run_ablation(df, y, seed)
    full_f1 = ablation["Full PRISM"]["F1"]

    # 4. Robustness
    if not args.quick:
        robustness = run_robustness(seed)
    else:
        print("\n[4] Robustness sweep skipped (--quick)")
        robustness = None

    # 5. Figures
    print("\n[5] Generating figures...")
    fig_baseline(results)
    fig_roc(y, rule_score, lr_probs, rf_probs, xgb_probs)
    fig_ablation(ablation, full_f1)
    if robustness:
        fig_robustness(robustness)

    # 6. LaTeX tables
    print("\n[6] Writing LaTeX tables...")
    if robustness:
        write_latex_tables(results, ablation, robustness)
    else:
        print("  Skipped (no robustness data)")

    # Summary
    best = max(results, key=lambda k: results[k]["F1"])
    print(f"\n{'=' * 60}")
    print(f"  SUMMARY")
    print(f"{'=' * 60}")
    print(f"  Best F1: {best} ({results[best]['F1']})")
    print(f"  PRISM-LR: F1={results['PRISM-LR (Learned)']['F1']} "
          f"AUC={results['PRISM-LR (Learned)']['AUC']}")
    print(f"  Ablation largest drop: "
          + max((l for l in ablation if l != "Full PRISM"),
                key=lambda l: full_f1 - ablation[l]["F1"])
          + f" ΔF1={-(max(full_f1 - ablation[l]['F1'] for l in ablation if l != 'Full PRISM')):.3f}")
    print(f"\n  Outputs saved to:")
    print(f"    {FIGURES}/   (figures)")
    print(f"    {DOCS}/      (LaTeX tables)")
    print("=" * 60)


if __name__ == "__main__":
    main()
