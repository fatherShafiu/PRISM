# EXPERIMENT 2 — BASELINE COMPARISON
# ══════════════════════════════════════════════════════════════════════════════

def run_baselines(df: pd.DataFrame, seed: int) -> dict:
    print("\n[2] Running baseline models...")
    y = df["fraud_label"].values
    X = get_features(df)
    Xs = StandardScaler().fit_transform(X)
    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=seed)
    results = {}

    # Rule-based PRISM
    rule_pred  = (df["prism_decision"] == "hold_review").astype(int).values
    rule_score = -df["prism_score"].values
    rs_max = rule_score.max() or 1
    results["PRISM (Rule-based)"] = metrics(y, rule_pred, rule_score / rs_max)

    # PRISM-LR (learned weights via logistic regression)
    print("    PRISM-LR (logistic regression)...")
    lr = LogisticRegression(C=1.0, class_weight="balanced",
                            max_iter=1000, random_state=seed, solver="lbfgs")
    lr_probs = cross_val_predict(lr, Xs, y, cv=cv, method="predict_proba")[:, 1]
    lr_pred  = (lr_probs >= 0.5).astype(int)
    results["PRISM-LR (Learned)"] = metrics(y, lr_pred, lr_probs)
    lr.fit(Xs, y)  # fit on full data for coefficient extraction

    # Random Forest
    print("    Random Forest...")
    rf = RandomForestClassifier(n_estimators=200, class_weight="balanced",
                                random_state=seed, n_jobs=-1)
    rf_probs = cross_val_predict(rf, X, y, cv=cv, method="predict_proba")[:, 1]
    results["Random Forest"] = metrics(y, (rf_probs >= 0.5).astype(int), rf_probs)

    # XGBoost
    print("    XGBoost...")
    scale_pos = (y == 0).sum() / (y == 1).sum()
    xgb_m = xgb.XGBClassifier(n_estimators=200, max_depth=5, learning_rate=0.1,
                                scale_pos_weight=scale_pos, random_state=seed,
                                eval_metric="logloss", verbosity=0)
    xgb_probs = cross_val_predict(xgb_m, X, y, cv=cv, method="predict_proba")[:, 1]
    results["XGBoost"] = metrics(y, (xgb_probs >= 0.5).astype(int), xgb_probs)

    # Isolation Forest (unsupervised)
    print("    Isolation Forest...")
    iso = IsolationForest(contamination=0.20, random_state=seed, n_jobs=-1)
    iso_pred = (iso.fit_predict(Xs) == -1).astype(int)
    iso_score = -iso.score_samples(Xs)
    results["Isolation Forest"] = metrics(y, iso_pred, iso_score / iso_score.max())

    # One-Class SVM (trained on legitimate events only)
    print("    One-Class SVM...")
    ocsvm = OneClassSVM(nu=0.05, kernel="rbf", gamma="scale")
    ocsvm.fit(Xs[y == 0])
    ocsvm_pred = (ocsvm.predict(Xs) == -1).astype(int)
    ocsvm_score = -ocsvm.score_samples(Xs)
    results["One-Class SVM"] = metrics(y, ocsvm_pred, ocsvm_score / ocsvm_score.max())

    print(f"\n  {'Method':<25} {'P':>6} {'R':>6} {'F1':>6} {'FPR':>6} {'AUC':>7}")
    print(f"  {'-' * 57}")
    for method, m in results.items():
        bold = "* " if method.startswith("PRISM") else "  "
        print(f"  {bold}{method:<23} {m['Precision']:>6} {m['Recall']:>6} "
              f"{m['F1']:>6} {m['FPR']:>6} {m['AUC']:>7}")

    return results, lr, lr_probs, rf_probs, xgb_probs, rule_score, y, X, Xs


