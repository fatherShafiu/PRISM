# EXPERIMENT 3 — ABLATION STUDY
# ══════════════════════════════════════════════════════════════════════════════

def run_ablation(df: pd.DataFrame, y: np.ndarray, seed: int) -> dict:
    print("\n[3] Running ablation study...")
    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=seed)

    pillar_drop = {
        "Full PRISM":              [],
        "w/o Pillar 1 (Phone)":   ["phone_verified"],
        "w/o Pillar 2 (Temporal)": ["returned_in_window"],
        "w/o Pillar 3 (Threshold)": ["meets_threshold"],
        "w/o Pillar 4 (Caps)":    ["credit_requested_ghs", "stacked_credits",
                                    "both_discounts"],
        "w/o Pillar 5 (Graph)":   ["in_ring_cluster", "betweenness_centrality",
                                    "pagerank", "clustering_coeff",
                                    "public_code_exposure"],
    }

    ablation = {}
    full_f1 = None
    for label, drop_cols in pillar_drop.items():
        X_ab = get_features(df).drop(columns=drop_cols, errors="ignore")
        Xs_ab = StandardScaler().fit_transform(X_ab)
        lr_ab = LogisticRegression(C=1.0, class_weight="balanced",
                                   max_iter=1000, random_state=seed)
        pr_ab = cross_val_predict(lr_ab, Xs_ab, y, cv=cv, method="predict_proba")[:, 1]
        m = metrics(y, (pr_ab >= 0.5).astype(int), pr_ab)
        ablation[label] = m
        if label == "Full PRISM":
            full_f1 = m["F1"]
        delta = f"{m['F1'] - full_f1:+.3f}" if full_f1 and label != "Full PRISM" else "—"
        print(f"    {label:<35} F1={m['F1']:.3f}  ΔF1={delta}")

    return ablation


