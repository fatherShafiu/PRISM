def write_latex_tables(results: dict, ablation: dict, robustness: dict):
    lines = ["% PRISM Experiment Tables (auto-generated)\n"]

    # Baseline table
    lines += [
        r"\begin{table*}[ht]",
        r"\centering",
        r"\caption{Detection Performance: PRISM vs Baseline Methods}",
        r"\label{tab:baseline}",
        r"\begin{tabular}{@{}lrrrrr@{}}",
        r"\toprule",
        r"\textbf{Method} & \textbf{P} & \textbf{R} & \textbf{F1} & "
        r"\textbf{FPR} & \textbf{AUC} \\",
        r"\midrule",
    ]
    for method, m in results.items():
        b = r"\textbf{" if method.startswith("PRISM") else ""
        e = "}" if method.startswith("PRISM") else ""
        lines.append(f"{b}{method}{e} & {b}{m['Precision']}{e} & "
                     f"{b}{m['Recall']}{e} & {b}{m['F1']}{e} & "
                     f"{b}{m['FPR']}{e} & {b}{m['AUC']}{e} \\\\")
    lines += [r"\bottomrule", r"\end{tabular}", r"\end{table*}", ""]

    # Ablation table
    full_f1 = ablation["Full PRISM"]["F1"]
    lines += [
        r"\begin{table}[ht]",
        r"\centering",
        r"\caption{Ablation Study: Impact of Removing Each Pillar}",
        r"\label{tab:ablation}",
        r"\begin{tabular}{@{}lrrrr@{}}",
        r"\toprule",
        r"\textbf{Configuration} & \textbf{P} & \textbf{R} & \textbf{F1} & "
        r"\textbf{$\Delta$F1} \\",
        r"\midrule",
    ]
    for label, m in ablation.items():
        delta = f"{m['F1'] - full_f1:+.3f}" if label != "Full PRISM" else "—"
        b = r"\textbf{" if label == "Full PRISM" else ""
        e = "}" if label == "Full PRISM" else ""
        lines.append(f"{b}{label}{e} & {b}{m['Precision']}{e} & "
                     f"{b}{m['Recall']}{e} & {b}{m['F1']}{e} & "
                     f"{b}{delta}{e} \\\\")
    lines += [r"\bottomrule", r"\end{tabular}", r"\end{table}", ""]

    # Robustness table
    fr_list = list(robustness.keys())
    lines += [
        r"\begin{table}[ht]",
        r"\centering",
        r"\caption{Robustness: F1-Score Across Fraud Rates}",
        r"\label{tab:robustness}",
        r"\begin{tabular}{@{}lrrrr@{}}",
        r"\toprule",
        r"\textbf{Method} & \textbf{5\%} & \textbf{10\%} & "
        r"\textbf{20\%} & \textbf{30\%} \\",
        r"\midrule",
    ]
    for method, key in [("Rule-based", "Rule-based"), ("LR", "LR"), ("XGBoost", "XGBoost")]:
        vals = " & ".join(f"{robustness[fr][key]['F1']:.3f}" for fr in fr_list)
        b = r"\textbf{" if key == "LR" else ""
        e = "}" if key == "LR" else ""
        lines.append(f"{b}PRISM-{method}{e} & {vals} \\\\")
    lines += [r"\bottomrule", r"\end{tabular}", r"\end{table}"]

    path = DOCS / "prism_experiment_tables.tex"
    path.write_text("\n".join(lines))
    print(f"  ✓ prism_experiment_tables.tex")


