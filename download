# EXPERIMENT 4 — ROBUSTNESS SWEEP
# ══════════════════════════════════════════════════════════════════════════════

def run_robustness(seed: int) -> dict:
    print("\n[4] Running robustness sweep (fraud rates 5%–30%)...")
    sys.path.insert(0, str(Path(__file__).parent))
    from generate_dataset import generate_dataset, prism_score, prism_decision

    fraud_rates = [0.05, 0.10, 0.20, 0.30]
    robustness = {}
    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=seed)

    for fr in fraud_rates:
        print(f"    fraud_rate={fr:.0%}...", end=" ", flush=True)
        df_r, _, _ = generate_dataset(fraud_rate=fr, total=10_000, verbose=False)
        y_r = df_r["fraud_label"].values
        X_r = get_features(df_r)
        Xs_r = StandardScaler().fit_transform(X_r)

        # Rule-based
        rp = (df_r["prism_decision"] == "hold_review").astype(int).values
        rs = -df_r["prism_score"].values
        rule_m = metrics(y_r, rp, rs / max(rs.max(), 1))

        # PRISM-LR
        lr_r = LogisticRegression(C=1.0, class_weight="balanced",
                                   max_iter=1000, random_state=seed)
        lr_pr = cross_val_predict(lr_r, Xs_r, y_r, cv=cv, method="predict_proba")[:, 1]
        lr_m  = metrics(y_r, (lr_pr >= 0.5).astype(int), lr_pr)

        # XGBoost
        sp = (y_r == 0).sum() / max((y_r == 1).sum(), 1)
        xg_r = xgb.XGBClassifier(n_estimators=200, max_depth=5, learning_rate=0.1,
                                   scale_pos_weight=sp, random_state=seed,
                                   eval_metric="logloss", verbosity=0)
        xg_pr = cross_val_predict(xg_r, X_r, y_r, cv=cv, method="predict_proba")[:, 1]
        xg_m  = metrics(y_r, (xg_pr >= 0.5).astype(int), xg_pr)

        robustness[fr] = {"Rule-based": rule_m, "LR": lr_m, "XGBoost": xg_m}
        print(f"Rule F1={rule_m['F1']:.3f}  LR F1={lr_m['F1']:.3f}  XGB F1={xg_m['F1']:.3f}")

    return robustness


